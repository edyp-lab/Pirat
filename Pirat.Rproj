Version: 1.0
ProjectId: b3098ef8-7582-4b15-8290-1fa879965fef

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 4
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --with-keep.source
PackageBuildArgs: --keep-empty-dirs --no-resave-data
PackageBuildBinaryArgs: --keep-empty-dirs --no-resave-data
PackageCheckArgs: --timings
